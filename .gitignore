# Environment files with secrets.
# **/.env alone does NOT cover suffixed variants — .env.backup was committed
# through that gap and had to be purged from history. **/.env.* catches every
# variant (.env.backup, .env.production, .env.old); the !**/.env.example
# negation below re-includes the one file that is safe to track.
**/.env
**/.env.*
.env.local
.env.*.local

# JWT secret file generated by deploy.sh
**/.jwt_secret

# Keep example files
!**/.env.example

# Compiled binaries
**/bin/

# Uploaded and converted files (local bind-mount storage)
files/uploads/*
!files/uploads/.gitkeep
files/outputs/*
!files/outputs/.gitkeep

# k6 load-test result reports (JSON/HTML), generated by scripts/k6/run.sh
scripts/k6/results/*
!scripts/k6/results/.gitkeep
