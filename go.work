go 1.26.0

// Minimum toolchain for builds, tests and govulncheck (CI stage 8): the go
// command switches to it automatically. 1.26.10 carries the standard-library
// fixes govulncheck reported against 1.26.0 (2026-11-09). NOTE: keep in step
// with the pinned images deployment/base-go-builder.Dockerfile and
// deployment/test-binaries.Dockerfile.
toolchain go1.26.10

use (
	./ai-service
	./analytics-service
	./api-gateway
	./auth-service
	./convert-from-pdf
	./convert-to-pdf
	./document-service
	./job-service
	./notification-service
	./optimize-pdf
	./organize-pdf
	./shared
	./user-service
)
