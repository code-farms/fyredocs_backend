# Capacity-mode rate-limit overrides for LOAD TESTING ONLY.
#
# WHY: the suite drives traffic from one host/IP. The default limits (gateway
# API per plan, per-IP job-create/upload, per-IP login/signup) would throttle it
# and you'd measure the LIMITER, not the backend. Raise them for the test box so
# k6 finds the real capacity, then revert for production.
#
# HOW: append these to the TEST deployment's env, then redeploy, e.g.
#     cat scripts/k6/capacity-mode.env >> .env        # test box only!
#     ./deployment/deploy.sh
#   (Keep a backup of .env, or use a separate test .env. Do NOT commit/ship this
#    to production — these effectively disable abuse protection.)
#
# THEN VERIFY IT TOOK EFFECT — do not assume:
#     docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' \
#       $(docker compose -f deployment/docker-compose.yml --env-file .env ps -q api-gateway) \
#       | grep RATE_LIMIT_API_FREE          # expect 1000000, not 120
#   (`docker exec <svc> env` does NOT work: the service images are `scratch` and
#    have no env binary, so it fails silently and looks like "no vars set".)
#
# This file was inert until 2026-07-28: every value here only reaches a container
# if the service declares it under `environment:` in docker-compose.yml. Compose
# uses .env solely to interpolate ${...} into the compose FILE — it does not pass
# .env into containers. api-gateway/job-service declared none of these, and
# auth-service hardcoded them as literals ("3", "5"), so all three ignored this
# file and load runs measured the limiter. All three now interpolate with their
# Go defaults, so this file finally does what it says.

# --- Gateway per-plan API limits (requests/min) ---
# NOTE: the gateway reads RATE_LIMIT_API_GUEST (not _ANON) for unauthenticated
# traffic — matches api-gateway/main.go.
RATE_LIMIT_API_GUEST=1000000
RATE_LIMIT_API_FREE=1000000
RATE_LIMIT_API_PRO=1000000
RATE_LIMIT_API_WINDOW=60s

# --- job-service per-IP limits ---
RATE_LIMIT_JOB_CREATE=1000000
RATE_LIMIT_UPLOAD=1000000
RATE_LIMIT_DETECT=1000000

# --- auth-service per-IP limits (login/signup churn + reset/proxy) ---
RATE_LIMIT_LOGIN=1000000
RATE_LIMIT_SIGNUP=1000000
RATE_LIMIT_REFRESH=1000000
RATE_LIMIT_FORGOT_PASSWORD=1000000
RATE_LIMIT_RESET_PASSWORD=1000000
RATE_LIMIT_PROXY_LOGIN=1000000
# Shared per-IP window for auth-service + job-service limiters.
RATE_LIMIT_WINDOW=60s
