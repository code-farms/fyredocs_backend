# Fyredocs edge: TLS termination, SPA static files, direct MinIO byte
# routing, and API proxying to the api-gateway.
#
# PUBLIC_DOMAIN unset (default)     → plain HTTP on :80 (local/dev).
# PUBLIC_DOMAIN=docs.example.com    → automatic HTTPS via Let's Encrypt.
#
# This replaces two responsibilities the gateway used to carry in-process:
# serving the SPA and relaying object bytes to MinIO. File bandwidth no
# longer competes with API routing for the gateway's CPU.

{$PUBLIC_DOMAIN::80} {
	encode gzip zstd

	# ---- Object storage: presigned URLs go straight to MinIO ----------
	# Host preservation is load-bearing: presigned SigV4 URLs are signed
	# against the public origin the browser uses (PUBLIC_ORIGIN, i.e. this
	# edge), and the signature covers the Host header. MinIO recomputes the
	# signature against the Host it receives, so the ORIGINAL Host must be
	# forwarded — never rewritten to the upstream host. Caddy's
	# reverse_proxy preserves the client Host by default; header_up makes
	# that explicit because correctness depends on it. The path is
	# forwarded verbatim for the same reason (SigV4 covers the canonical
	# path). The presigned signature itself is the credential on these
	# routes — no auth middleware applies.
	@objects path /{$S3_BUCKET_UPLOADS:uploads}/* /{$S3_BUCKET_OUTPUTS:outputs}/*
	handle @objects {
		# Never let a browser MIME-sniff object bytes into an executable type on
		# this origin (defense-in-depth; downloads already force attachment).
		header X-Content-Type-Options nosniff
		# MINIO_UPSTREAM is "minio:9000" on the single-host stack. On a multi-host
		# deploy it is the data host's PRIVATE address — all object bytes flow
		# browser -> this edge -> that host, so the edge carries the file
		# bandwidth. Serving MinIO from its own public subdomain would avoid the
		# hop but breaks `connect-src 'self'` in the CSP below; if you ever do
		# that, the CSP must change in the same commit or uploads fail.
		reverse_proxy {$MINIO_UPSTREAM:minio:9000} {
			header_up Host {host}
			# Multipart parts arrive from the browser in parallel; allow
			# long transfers to stream without buffering.
			flush_interval -1
		}
	}

	# ---- API, auth, and admin routes → api-gateway ---------------------
	# /metrics is intentionally NOT routed: Prometheus scrapes services on
	# the internal network; metrics are no longer internet-reachable.
	#
	# Only the root /admin API paths that still have callers are proxied
	# (legacy unversioned /admin/metrics/* and the /admin/authz probe); the
	# web and mobile clients use /api/v1/admin/*. A blanket /admin/* sent the
	# SPA's own admin pages (/admin/growth, /admin/activity, ...) to the
	# gateway, so a refresh or deep link 404'd — or returned analytics JSON
	# where an API route shares the page's path.
	@api path /api/* /auth/* /admin/metrics/* /admin/authz /healthz
	handle @api {
		# Load balanced across every api-gateway listed in API_GATEWAY_UPSTREAMS
		# (space-separated "host:port"). Defaults to the single-host container
		# name, so the local stack needs no configuration.
		#
		# This used to resolve upstreams via `dynamic a` against Docker's embedded
		# DNS at 127.0.0.11, which auto-discovered replicas from
		# `docker compose up -d --scale api-gateway=N`. That resolver only ever
		# sees containers on the SAME host, so it cannot find a second app
		# server's gateway — the whole point of a separate edge host. The static
		# list is the trade: replicas are now enumerated explicitly, and in
		# exchange active health checks work (they are unsupported for dynamic
		# upstreams), so a dead gateway is detected by probe rather than only
		# after real requests fail into it.
		reverse_proxy {$API_GATEWAY_UPSTREAMS:api-gateway:8080} {
			lb_policy       least_conn
			lb_try_duration 5s
			lb_try_interval 250ms

			# Active probe. /healthz is routed to the gateway by this very
			# matcher, so it is a real end-to-end check of the upstream.
			health_uri      /healthz
			health_interval 10s
			health_timeout  5s

			# Passive ejection still applies, covering failures a 200 on
			# /healthz would not reveal.
			fail_duration    30s
			max_fails        3
			unhealthy_status 5xx

			flush_interval -1
		}
	}

	# ---- Grafana (observability profile) → embedded in the admin SPA ---
	# Same-origin path so the admin "Observability" tab can iframe Grafana.
	# This bypasses the gateway proxy, so it carries its OWN auth: forward_auth
	# hands each request to the gateway's /admin/authz probe (JWT verify +
	# super-admin role via analytics-service adminAuth). A non-2xx short-circuits
	# before Grafana is reached, so only admins can load the embed even though
	# Grafana itself runs in anonymous Viewer mode. Only started under the
	# `observability` compose profile — 502s here when the profile is down.
	# On a multi-host deploy, GRAFANA_UPSTREAM points at the data host (where the
	# observability profile runs) and the forward_auth target at an app host.
	# Both 502 when the profile is down, same as on a single host.
	@grafana path /grafana /grafana/*
	handle @grafana {
		forward_auth {$AUTHZ_UPSTREAM:api-gateway:8080} {
			uri /admin/authz
		}
		reverse_proxy {$GRAFANA_UPSTREAM:grafana:3000}
	}

	# ---- SPA (client-side routed) --------------------------------------
	handle {
		root * /srv/spa
		# Security headers on the app document + assets. The api-gateway sets its
		# own headers on /api /auth /admin; these cover the Caddy-served SPA, which
		# previously shipped none (production-readiness S8 / finding A1).
		header {
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			# HSTS: browsers ignore it over plain HTTP, so this is inert for the
			# local :80 setup and takes effect only behind the automatic TLS a
			# PUBLIC_DOMAIN deploy gets. Deliberately no `preload` — that is a
			# one-way, hard-to-undo commitment; add it once the domain is final.
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			# CSP: the SPA is self-contained — same-origin APIs, presigned URLs, and
			# the same-origin Grafana embed (default-src 'self' permits that iframe).
			# style-src allows 'unsafe-inline' for Tailwind/Radix inline styles, the
			# chart <style>, and inline Mermaid SVG. VALIDATE against the running app
			# (open the docs page with Mermaid + charts, watch the browser console)
			# and relax a single directive only if a legitimate resource is blocked.
			#
			# {$CSP_AD_DOMAINS} is empty by default (→ strict, same-origin only). To
			# run ad networks, set CSP_AD_DOMAINS in .env to their space-separated
			# hosts (and usually 'unsafe-inline'); it is appended to script/img/
			# connect/frame-src. See docs/developer/architecture/caddy-edge.md.
			# plausible.io is allowlisted in script-src (the analytics snippet in
			# index.html) and connect-src (its event beacon). Without both, the
			# script and every pageview are blocked SILENTLY — no console error
			# the user would notice, just zero analytics. Inter is bundled with
			# the app, so fonts stay same-origin.
			Content-Security-Policy "default-src 'self'; script-src 'self' https://plausible.io {$CSP_AD_DOMAINS}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$CSP_AD_DOMAINS}; font-src 'self' data:; connect-src 'self' https://plausible.io {$CSP_AD_DOMAINS}; frame-src 'self' {$CSP_AD_DOMAINS}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}
		# Hashed assets are immutable. A missing one must 404 rather than fall
		# through to index.html: a tab still running the previous build asks for
		# chunks the deploy deleted, and an HTML 200 for a .js import surfaces as
		# an opaque "Failed to fetch dynamically imported module" instead of a
		# clean failure the SPA's lazyWithReload can recover from.
		#
		# Two sibling handles, not a nested handle beside try_files: Caddy runs
		# try_files (a rewrite) before handle, so the asset path would already
		# be rewritten to /index.html by the time an inner handle matched.
		@assets path /assets/*
		handle @assets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# index.html (and the SPA fallback) must revalidate on every load, or the
		# browser heuristically caches it and keeps requesting a previous
		# build's chunk names after a deploy. no-cache still allows a 304.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
